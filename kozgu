#!/usr/bin/env bash
# KO'ZGU launcher.  Resolves symlinks first — /usr/local/bin/kozgu is
# a symlink into /opt/kozgu/, and without realpath the script would
# look for `src/` next to the symlink and error out.
SCRIPT="$( readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}" )"
SCRIPT_DIR="$( cd "$( dirname "$SCRIPT" )" && pwd )"

# locate the installed src directory
if [ -d "$SCRIPT_DIR/src" ]; then
    APP_DIR="$SCRIPT_DIR"
elif [ -d "/opt/kozgu/src" ]; then
    APP_DIR="/opt/kozgu"
else
    echo "kozgu: cannot locate application files (looked in $SCRIPT_DIR and /opt/kozgu)" >&2
    exit 1
fi

# prefer python3
PYTHON_BIN="${KOZGU_PYTHON:-python3}"
if ! command -v "$PYTHON_BIN" >/dev/null 2>&1; then
    echo "kozgu: python3 is required" >&2
    exit 1
fi

exec "$PYTHON_BIN" "$APP_DIR/src/main.py" "$@"
